{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Offline routing evaluation report v1",
  "type": "object",
  "required": ["schema_version", "contracts", "disk_evidence", "runtime_identity", "model_evaluation", "limitations"],
  "properties": {
    "schema_version": {"const": 1},
    "contracts": {
      "type": "object", "required": ["status", "evidence_level", "tool_count", "scenario_count", "missing_tools", "schema_drift", "skill_call_checks"],
      "properties": {
        "status": {"enum": ["PASS", "FAIL"]}, "evidence_level": {"const": "DISK_CONTRACT"},
        "tool_count": {"type": "integer", "minimum": 0}, "scenario_count": {"type": "integer", "minimum": 1},
        "missing_tools": {"type": "array", "items": {"type": "string"}},
        "schema_drift": {"type": "array", "items": {"type": "string"}},
        "skill_call_checks": {"type": "array", "items": {"type": "object"}}
      }
    },
    "disk_evidence": {"type": "object", "required": ["server", "skills_sha256", "client_loaded_state"], "properties": {"client_loaded_state": {"const": "UNKNOWN"}}},
    "runtime_identity": {"type": "object", "required": ["status", "client_skill_state", "client_plugin_state"], "properties": {"status": {"enum": ["UNKNOWN", "MATCH", "DIFFERENT"]}, "client_skill_state": {"const": "unknown"}, "client_plugin_state": {"const": "unknown"}}},
    "model_evaluation": {
      "type": "object", "required": ["status", "evidence_level", "trace_count", "valid_trace_count", "scenarios", "results", "benchmark"],
      "properties": {
        "status": {"enum": ["NOT_RUN", "INVALID", "PASS", "FAIL"]},
        "evidence_level": {"enum": ["NONE", "IMPORTED_TRACE"]},
        "trace_count": {"type": "integer", "minimum": 0}, "valid_trace_count": {"type": "integer", "minimum": 0},
        "scenarios": {"type": "object", "additionalProperties": {"enum": ["NOT_RUN", "EVALUATED"]}},
        "benchmark": {"const": "NOT_RUN"},
        "results": {"type": "array", "items": {
          "type": "object", "required": ["status", "evidence_level", "independently_attested", "violations"],
          "properties": {"status": {"enum": ["INVALID", "PASS", "FAIL"]}, "evidence_level": {"const": "IMPORTED_TRACE"}, "independently_attested": {"const": false}, "violations": {"type": "array", "items": {"type": "string"}}}
        }}
      },
      "allOf": [{"if": {"properties": {"trace_count": {"const": 0}}}, "then": {"properties": {"status": {"const": "NOT_RUN"}, "evidence_level": {"const": "NONE"}, "results": {"maxItems": 0}}}}]
    },
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
